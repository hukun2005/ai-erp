# 服务配置示例，复制为 .env 后修改
SECRET_KEY=change-me-to-a-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# 数据库（默认 SQLite，可改为 MySQL/PostgreSQL）
# DATABASE_URL=sqlite:///./erp.db

# 大模型（可选）：留空则使用内置规则引擎
# 常见配置：
#   智谱 GLM-4-Flash   LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4  LLM_MODEL=glm-4-flash
#   DeepSeek           LLM_BASE_URL=https://api.deepseek.com/v1           LLM_MODEL=deepseek-flash
#   本地 Ollama        LLM_BASE_URL=http://127.0.0.1:11434/v1             LLM_MODEL=qwen2.5:7b
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 问答链路调优（可选）：轮次越多越准，但更慢也更贵
# LLM_MAX_TOOL_ROUNDS：最多几轮工具调用；用尽后会强制模型基于已取到的数据收口
# LLM_MAX_TOOL_CALLS：一次提问内最多执行多少个工具调用（防止模型来回打转）
# LLM_TOOL_RESULT_CHARS：单个工具结果给模型的最大字符数，超长会按行裁剪并标注 truncated
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOOL_ROUNDS=6
LLM_MAX_TOOL_CALLS=12
LLM_TEMPERATURE=0.2
LLM_MAX_HISTORY=8
LLM_TOOL_RESULT_CHARS=6000

# 视觉模型（入库单照片识别，可选）：默认复用上面的 LLM 端点与 Key
# 智谱端点默认用 glm-4v-flash；其他厂商默认复用 LLM_MODEL，该模型必须支持图片输入
# 要单独走另一家视觉服务时，把三项都填上
# VISION_API_KEY=
# VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# VISION_MODEL=glm-4v-flash
VISION_TIMEOUT_SECONDS=60

# 飞书群机器人（可选）：在飞书群「设置 → 群机器人 → 添加自定义机器人」复制 Webhook 地址
# 开启「签名校验」时把密钥填到 FEISHU_SECRET，未开启留空即可
FEISHU_WEBHOOK_URL=
FEISHU_SECRET=
FEISHU_TIMEOUT_SECONDS=8

# 客户信用额度管控：off=不检查，warn=只提示，block=超额禁止确认出库
CREDIT_POLICY=warn

# 定时调度器：没有它，没人动库存时系统不会主动预警
SCHEDULER_ENABLED=1
SCHEDULER_TICK_SECONDS=60
# 库存巡检周期（分钟）
ALERT_SCAN_MINUTES=30
# 自动化规则求值周期（分钟）
AUTOMATION_INTERVAL_MINUTES=10
