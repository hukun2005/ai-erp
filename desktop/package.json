{
  "name": "ai-erp-desktop",
  "version": "1.0.9",
  "description": "AI-ERP 智能管理系统桌面版",
  "private": true,
  "main": "electron/main.js",
  "author": "AI-ERP",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.aierp.desktop",
    "productName": "AI-ERP",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "ui/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/erp-server",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../ai-erp-user-manual-v1.4-20261106.pdf",
        "to": "docs/ai-erp-user-manual.pdf"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "AI-ERP-${version}-win-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI-ERP",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "AI-ERP-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.example.com/ai-erp/"
      }
    ]
  }
}



